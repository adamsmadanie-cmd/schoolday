<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
<meta name="theme-color" content="#050B1A" />
<meta name="description" content="SCHOOLDAY — L'université IA mondiale. 9 professeurs intelligents, 200+ cours, classement planétaire." />
<title>SCHOOLDAY — L'université IA mondiale</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎓</text></svg>" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />

<style>
/* ============================================================
   SCHOOLDAY v3 — DESIGN PREMIUM + PHOTO DE FOND
   Firebase : intact
   ============================================================ */
:root {
  --night: #050B1A;
  --night-2: #0A1528;
  --night-3: #0F1F3A;
  --gold: #FFC93C; --gold-2: #FFD966;
  --cyan: #00D4FF; --purple: #7C3AED;
  --green: #22C55E; --red: #EF4444; --yellow: #F59E0B;
  --white: #FFFFFF;
  --white-90: rgba(255,255,255,0.90);
  --white-70: rgba(255,255,255,0.70);
  --white-60: rgba(255,255,255,0.60);
  --white-40: rgba(255,255,255,0.40);
  --white-20: rgba(255,255,255,0.20);
  --white-10: rgba(255,255,255,0.10);
  --white-05: rgba(255,255,255,0.05);
  --radius: 18px; --radius-lg: 28px; --radius-sm: 12px;
  --shadow: 0 24px 60px rgba(0,0,0,0.45);
  --shadow-gold: 0 10px 30px rgba(255,201,60,0.35);
  --shadow-cyan: 0 10px 30px rgba(0,212,255,0.30);
  --transition: 260ms cubic-bezier(0.22, 1, 0.36, 1);
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
body {
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  background: var(--night); color: var(--white);
  min-height: 100vh; overflow-x: hidden; line-height: 1.55;
  -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
  font-size: 15px;
}
h1, h2, h3, h4 { font-family: 'Space Grotesk', sans-serif; letter-spacing: -0.025em; line-height: 1.12; }
button { font-family: inherit; }
input, select, textarea { font-family: inherit; }
.mono { font-family: 'JetBrains Mono', monospace; }
.hidden { display: none !important; }

/* ---- FOND ANIMÉ AVEC TA PHOTO ---- */
.hero-bg { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
.hero-bg-photo {
  position: absolute; inset: 0;
  /* ⚠️ REMPLACE PAR TON LIEN DIRECT IMGBB */
  background-image: url('https://i.ibb.co/TON-LIEN-DIRECT/photo.jpg');
  background-size: cover;
  background-position: center 25%;
  opacity: 0.35;
  filter: blur(3px) brightness(0.55) saturate(1.15);
  animation: slowZoom 30s ease-in-out infinite alternate;
  transform-origin: center;
  will-change: transform;
}
@keyframes slowZoom {
  0%   { transform: scale(1.05) translate(0, 0); }
  100% { transform: scale(1.18) translate(-3%, -2%); }
}
.hero-bg-overlay {
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse at 30% 20%, rgba(0,212,255,0.12), transparent 55%),
    radial-gradient(ellipse at 70% 80%, rgba(255,201,60,0.08), transparent 55%),
    linear-gradient(180deg, rgba(5,11,26,0.55) 0%, rgba(5,11,26,0.45) 40%, rgba(5,11,26,0.90) 100%);
}
.orbs { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
.orb { position: absolute; border-radius: 50%; filter: blur(130px); opacity: 0.30; }
.orb-1 { width: 560px; height: 560px; background: var(--cyan); top: -160px; left: -160px; animation: float1 22s ease-in-out infinite; }
.orb-2 { width: 440px; height: 440px; background: var(--gold); bottom: -180px; right: -120px; opacity: 0.18; animation: float2 26s ease-in-out infinite; }
.orb-3 { width: 400px; height: 400px; background: var(--purple); top: 42%; left: 52%; opacity: 0.14; animation: float3 30s ease-in-out infinite; }
@keyframes float1 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(50px, 40px); } }
@keyframes float2 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(-60px, -40px); } }
@keyframes float3 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(-40px, 50px); } }

.app { position: relative; z-index: 1; min-height: 100vh; display: flex; flex-direction: column; }
.container { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 24px; }

/* ---- NAV ---- */
.nav {
  position: sticky; top: 0; z-index: 100;
  backdrop-filter: blur(24px) saturate(160%);
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  background: rgba(5,11,26,0.72);
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.nav-inner { display: flex; align-items: center; justify-content: space-between; padding: 14px 24px; max-width: 1200px; margin: 0 auto; gap: 16px; }

.logo {
  display: flex; align-items: center; gap: 12px;
  font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 22px;
  color: var(--white); cursor: pointer; background: none; border: none; padding: 0;
  perspective: 900px;
}
.logo-3d { width: 46px; height: 46px; position: relative; flex-shrink: 0; transform-style: preserve-3d; animation: logoRotate 8s ease-in-out infinite; }
@keyframes logoRotate { 0%, 100% { transform: rotateY(-12deg) rotateX(6deg); } 50% { transform: rotateY(12deg) rotateX(-6deg); } }
.logo-pen {
  position: absolute; inset: 0;
  background: linear-gradient(135deg, #FFD966 0%, #FFC93C 40%, #FF9A3C 100%);
  border-radius: 13px; display: flex; align-items: center; justify-content: center;
  box-shadow:
    0 8px 24px rgba(255,201,60,0.40),
    inset 0 -3px 10px rgba(0,0,0,0.20),
    inset 0 3px 10px rgba(255,255,255,0.45);
}
.logo-pen::before {
  content: ''; position: absolute; top: -4px; left: -4px; right: -4px; bottom: -4px;
  border-radius: 17px;
  background: linear-gradient(135deg, var(--gold), var(--cyan), var(--purple), var(--gold));
  background-size: 300% 300%;
  z-index: -1; opacity: 0.6; filter: blur(10px);
  animation: glowRotate 6s linear infinite;
}
@keyframes glowRotate {
  0% { background-position: 0% 50%; }
  100% { background-position: 300% 50%; }
}
.logo-pen svg { width: 26px; height: 26px; filter: drop-shadow(1px 1px 2px rgba(0,0,0,0.35)); }
.logo-pen::after {
  content: ''; position: absolute; top: 4px; left: 8px; right: 8px; height: 38%;
  background: linear-gradient(180deg, rgba(255,255,255,0.55), transparent);
  border-radius: 8px 8px 50% 50%; pointer-events: none;
}
.logo-text { font-size: 20px; letter-spacing: -0.02em; }
.logo-text span { color: var(--gold); }

.nav-links { display: flex; gap: 4px; align-items: center; }
.nav-link {
  position: relative;
  padding: 8px 14px; border-radius: 10px;
  color: var(--white-60); text-decoration: none;
  font-size: 14px; font-weight: 500;
  background: none; border: none; cursor: pointer;
  transition: var(--transition); white-space: nowrap;
}
.nav-link:hover { color: var(--white); background: rgba(255,255,255,0.05); }
.nav-link.active { color: var(--gold); background: rgba(255,201,60,0.10); }
.nav-link.active::after {
  content: ''; position: absolute; left: 50%; bottom: -14px; transform: translateX(-50%);
  width: 20px; height: 2px; border-radius: 2px;
  background: var(--gold); box-shadow: 0 0 10px var(--gold);
}

.fb-status {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 5px 11px; border-radius: 100px;
  font-size: 11px; font-weight: 600;
  border: 1px solid transparent;
}
.fb-on  { background: rgba(34,197,94,0.12); color: var(--green); border-color: rgba(34,197,94,0.25); }
.fb-off { background: rgba(245,158,11,0.12); color: var(--yellow); border-color: rgba(245,158,11,0.25); }
.fb-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; animation: pulse 2s infinite; }
@keyframes pulse { 0%,100%{opacity:1;transform:scale(1);} 50%{opacity:0.5;transform:scale(0.85);} }

/* ---- BOUTONS ---- */
.btn {
  position: relative;
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  padding: 13px 24px; border-radius: var(--radius-sm);
  font-size: 14px; font-weight: 600;
  border: none; cursor: pointer; text-decoration: none;
  transition: var(--transition); white-space: nowrap;
  overflow: hidden;
}
.btn::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(255,255,255,0.20), transparent 50%);
  pointer-events: none; border-radius: inherit;
}
.btn-primary {
  background: linear-gradient(135deg, #FFD966, #FFC93C 60%, #FFB53C);
  color: #0A1528; box-shadow: var(--shadow-gold);
}
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 14px 36px rgba(255,201,60,0.45); }
.btn-primary:active { transform: translateY(0); }
.btn-primary:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
.btn-ghost {
  background: rgba(255,255,255,0.04); color: var(--white);
  border: 1px solid rgba(255,255,255,0.15);
}
.btn-ghost:hover { border-color: var(--cyan); background: rgba(0,212,255,0.08); color: var(--white); }
.btn-cyan { background: linear-gradient(135deg, #33E0FF, #00D4FF 60%, #00B8E0); color: #0A1528; box-shadow: var(--shadow-cyan); }
.btn-danger { background: transparent; color: var(--red); border: 1px solid rgba(239,68,68,0.35); }
.btn-danger:hover { background: rgba(239,68,68,0.10); border-color: var(--red); }
.btn-google {
  background: #fff; color: #1F2937; border: 1px solid #E5E7EB;
  box-shadow: 0 4px 14px rgba(0,0,0,0.20);
}
.btn-google:hover { background: #F9FAFB; transform: translateY(-1px); box-shadow: 0 8px 20px rgba(0,0,0,0.25); }
.btn-block { width: 100%; }
.btn-sm { padding: 9px 16px; font-size: 13px; }

/* ---- CARTES ---- */
.card {
  position: relative;
  background: rgba(255,255,255,0.045);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: var(--radius);
  padding: 26px;
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  transition: var(--transition);
  overflow: hidden;
}
.card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.20), transparent);
  pointer-events: none;
}
.card:hover { border-color: rgba(255,255,255,0.14); }

/* ---- FORMULAIRES ---- */
.field { margin-bottom: 18px; }
.field label { display: block; font-size: 13px; font-weight: 500; color: var(--white-60); margin-bottom: 8px; letter-spacing: 0.01em; }
.input, .select, .textarea {
  width: 100%; padding: 14px 17px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.10);
  border-radius: var(--radius-sm);
  color: var(--white); font-size: 14px;
  transition: var(--transition);
}
.input::placeholder, .textarea::placeholder { color: var(--white-40); }
.input:focus, .select:focus, .textarea:focus {
  outline: none;
  border-color: var(--cyan);
  background: rgba(0,212,255,0.06);
  box-shadow: 0 0 0 4px rgba(0,212,255,0.12), 0 0 20px rgba(0,212,255,0.15);
}
.select option { background: var(--night-2); color: var(--white); }
.error-text { color: var(--red); font-size: 12px; margin-top: 6px; display: block; }

/* ---- BADGES ---- */
.badge { display: inline-flex; align-items: center; gap: 6px; padding: 5px 11px; border-radius: 100px; font-size: 12px; font-weight: 600; }
.badge-cyan { background: rgba(0,212,255,0.12); color: var(--cyan); border: 1px solid rgba(0,212,255,0.20); }

/* ---- ÉCRANS ---- */
.screen { display: none; animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1); }
.screen.active { display: block; }
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16px) scale(0.99); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* ---- HERO ---- */
.hero { padding: 100px 0 80px; text-align: center; position: relative; }
.hero h1 {
  font-size: clamp(52px, 10vw, 110px);
  font-weight: 700; line-height: 0.95; letter-spacing: -0.045em;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFFFF 40%, #FFC93C 60%, #00D4FF 100%);
  background-size: 200% 200%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: gradientShift 8s ease-in-out infinite;
  margin-bottom: 8px;
  filter: drop-shadow(0 8px 30px rgba(0,212,255,0.25));
}
@keyframes gradientShift {
  0%,100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}
.hero h1 span {
  background: linear-gradient(135deg, #FFC93C, #FF9A3C);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.hero p { margin: 28px auto 0; max-width: 620px; color: var(--white-70); font-size: 18px; line-height: 1.6; text-shadow: 0 2px 12px rgba(0,0,0,0.5); }
.hero-actions { margin-top: 44px; display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

.stats {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  gap: 18px; margin-top: 84px;
}
.stat {
  position: relative;
  background: linear-gradient(160deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: var(--radius);
  padding: 26px 18px; text-align: center;
  backdrop-filter: blur(20px);
  transition: var(--transition);
}
.stat:hover {
  transform: translateY(-4px);
  border-color: rgba(255,201,60,0.30);
  box-shadow: 0 20px 40px rgba(0,0,0,0.30), 0 0 30px rgba(255,201,60,0.10);
}
.stat .num {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 38px; font-weight: 700;
  background: linear-gradient(135deg, #FFD966, #FFC93C, #FF9A3C);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.stat .lbl { font-size: 13px; color: var(--white-60); margin-top: 8px; font-weight: 500; }

/* ---- SECTIONS ---- */
.section { padding: 70px 0; }
.section-head { text-align: center; margin-bottom: 48px; }
.section-head h2 { font-size: clamp(30px, 4.5vw, 44px); font-weight: 700; letter-spacing: -0.03em; }
.section-head p { color: var(--white-60); margin-top: 12px; font-size: 16px; }

.profs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 18px; }
.prof {
  position: relative;
  background: linear-gradient(160deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: var(--radius);
  padding: 26px 22px;
  cursor: pointer; transition: var(--transition);
  text-align: left; color: var(--white); font-family: inherit;
  overflow: hidden;
}
.prof::before {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(circle at top right, rgba(0,212,255,0.15), transparent 60%);
  opacity: 0; transition: var(--transition);
  pointer-events: none;
}
.prof:hover {
  border-color: rgba(0,212,255,0.35);
  transform: translateY(-6px);
  box-shadow: 0 24px 48px rgba(0,0,0,0.35), 0 0 40px rgba(0,212,255,0.12);
}
.prof:hover::before { opacity: 1; }
.prof-emoji {
  font-size: 42px; margin-bottom: 14px;
  filter: drop-shadow(0 4px 12px rgba(0,0,0,0.30));
  transition: var(--transition);
  display: inline-block;
}
.prof:hover .prof-emoji { transform: scale(1.15) rotate(-5deg); }
.prof-name { font-weight: 700; font-size: 16px; position: relative; z-index: 1; }
.prof-subj { color: var(--white-60); font-size: 13px; margin-top: 4px; position: relative; z-index: 1; }

/* ---- AUTH ---- */
.auth-wrap { min-height: calc(100vh - 73px); display: flex; align-items: center; justify-content: center; padding: 40px 20px; }
.auth-card {
  width: 100%; max-width: 560px;
  background: linear-gradient(180deg, rgba(10,21,40,0.85), rgba(10,21,40,0.65));
  border: 1px solid rgba(255,255,255,0.10);
  border-radius: var(--radius-lg);
  padding: 44px;
  backdrop-filter: blur(32px);
  -webkit-backdrop-filter: blur(32px);
  box-shadow: 0 30px 80px rgba(0,0,0,0.60), inset 0 1px 0 rgba(255,255,255,0.08);
  position: relative;
  overflow: hidden;
}
.auth-card::before {
  content: ''; position: absolute; top: -50%; left: -50%;
  width: 200%; height: 200%;
  background: radial-gradient(circle at 30% 20%, rgba(0,212,255,0.10), transparent 40%),
              radial-gradient(circle at 70% 80%, rgba(255,201,60,0.08), transparent 40%);
  pointer-events: none;
}
.auth-card > * { position: relative; z-index: 1; }
.auth-card h1 { font-size: 34px; text-align: center; margin-bottom: 8px; }
.auth-card .sub { text-align: center; color: var(--white-60); margin-bottom: 34px; font-size: 14px; }
.auth-divider { display: flex; align-items: center; gap: 14px; margin: 26px 0; color: var(--white-40); font-size: 12px; }
.auth-divider::before, .auth-divider::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.12), transparent); }

.steps { display: flex; gap: 10px; margin-bottom: 30px; }
.step { flex: 1; height: 4px; border-radius: 100px; background: rgba(255,255,255,0.08); transition: var(--transition); }
.step.active { background: linear-gradient(90deg, #FFC93C, #FF9A3C); box-shadow: 0 0 12px rgba(255,201,60,0.50); }

.subjects-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; margin-bottom: 22px; }
.subject-chip {
  padding: 15px 13px; border-radius: var(--radius-sm);
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.10);
  color: var(--white); cursor: pointer;
  transition: var(--transition); text-align: left; font-family: inherit;
}
.subject-chip:hover { border-color: var(--cyan); background: rgba(0,212,255,0.06); transform: translateY(-2px); }
.subject-chip.selected {
  background: linear-gradient(135deg, #FFD966, #FFC93C 60%, #FFB53C);
  color: #0A1528; border-color: var(--gold);
  box-shadow: 0 8px 20px rgba(255,201,60,0.30);
}
.subject-chip .emoji { font-size: 24px; display: block; }
.subject-chip .name { font-weight: 600; font-size: 13px; margin-top: 5px; display: block; }
.subject-chip .teacher { font-size: 11px; opacity: 0.75; margin-top: 3px; display: block; }

.matricule-box {
  background: linear-gradient(135deg, rgba(255,201,60,0.12), rgba(255,201,60,0.04));
  border: 1px solid rgba(255,201,60,0.35);
  border-radius: var(--radius); padding: 22px; text-align: center; margin: 24px 0;
  box-shadow: 0 0 30px rgba(255,201,60,0.10), inset 0 1px 0 rgba(255,255,255,0.10);
}
.matricule-box .label { font-size: 11px; color: var(--white-60); text-transform: uppercase; letter-spacing: 0.15em; font-weight: 600; }
.matricule-box .value {
  font-family: 'JetBrains Mono', monospace;
  font-size: 26px; font-weight: 700;
  background: linear-gradient(135deg, #FFD966, #FFC93C, #FF9A3C);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-top: 10px; word-break: break-all;
}

/* ---- DASHBOARD ---- */
.dash { padding: 44px 0; }
.dash-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; flex-wrap: wrap; margin-bottom: 36px; }
.dash-header h1 { font-size: 34px; letter-spacing: -0.03em; }
.dash-header .meta { color: var(--white-60); font-size: 14px; margin-top: 8px; }
.stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 16px; margin-bottom: 44px; }
.two-col { display: grid; grid-template-columns: 2fr 1fr; gap: 26px; }
@media (max-width: 900px) { .two-col { grid-template-columns: 1fr; } }

.leaderboard { display: flex; flex-direction: column; }
.leaderboard-row { display: flex; align-items: center; gap: 12px; padding: 13px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
.leaderboard-row:last-child { border-bottom: none; }
.rank {
  width: 36px; height: 36px; border-radius: 10px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 13px; font-family: 'JetBrains Mono', monospace;
  flex-shrink: 0;
}
.rank.top-1 { background: linear-gradient(135deg, #FFD966, #FF9A3C); color: #0A1528; border-color: transparent; box-shadow: 0 6px 20px rgba(255,201,60,0.40); }
.rank.top-2 { background: linear-gradient(135deg, #E0E0E0, #A0A0A0); color: #0A1528; border-color: transparent; }
.rank.top-3 { background: linear-gradient(135deg, #E0A060, #A05A20); color: #fff; border-color: transparent; }
.lb-name { flex: 1; font-size: 14px; min-width: 0; font-weight: 500; }
.lb-xp { color: var(--gold); font-weight: 700; font-size: 14px; font-family: 'JetBrains Mono', monospace; }

.course-list { display: flex; flex-direction: column; gap: 12px; }
.course-item {
  display: flex; align-items: center; gap: 14px;
  padding: 16px;
  background: linear-gradient(160deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02));
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: var(--radius-sm);
  cursor: pointer; transition: var(--transition);
}
.course-item:hover {
  border-color: rgba(0,212,255,0.35);
  transform: translateX(6px);
  box-shadow: 0 12px 30px rgba(0,0,0,0.25), 0 0 20px rgba(0,212,255,0.10);
}
.course-emoji {
  width: 48px; height: 48px; border-radius: 12px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  display: flex; align-items: center; justify-content: center;
  font-size: 24px; flex-shrink: 0;
}
.course-info { flex: 1; min-width: 0; }
.course-title { font-weight: 600; font-size: 14px; }
.course-teacher { font-size: 12px; color: var(--white-60); margin-top: 3px; }
.course-progress { width: 100%; height: 5px; background: rgba(255,255,255,0.08); border-radius: 100px; margin-top: 8px; overflow: hidden; }
.course-progress > div {
  height: 100%;
  background: linear-gradient(90deg, #FFC93C, #FF9A3C);
  box-shadow: 0 0 10px rgba(255,201,60,0.50);
  transition: width 0.6s ease;
}

/* ---- PROFIL ---- */
.profile-avatar {
  width: 84px; height: 84px; border-radius: 50%;
  border: 3px solid var(--gold);
  display: flex; align-items: center; justify-content: center;
  font-size: 34px; font-weight: 700; color: #0A1528;
  background: linear-gradient(135deg, #FFD966, #FF9A3C);
  overflow: hidden; flex-shrink: 0;
  box-shadow: 0 10px 30px rgba(255,201,60,0.40), inset 0 2px 8px rgba(255,255,255,0.30);
}
.profile-avatar img { width: 100%; height: 100%; object-fit: cover; }
